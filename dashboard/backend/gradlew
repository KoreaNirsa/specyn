#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
GRADLE_VERSION="${SPECYN_GRADLE_VERSION:-8.14}"
LOCAL_GRADLE="$REPO_ROOT/.specyn/tools/gradle-$GRADLE_VERSION/bin/gradle"

if [[ -f "$LOCAL_GRADLE" && ! -x "$LOCAL_GRADLE" ]]; then
  chmod +x "$LOCAL_GRADLE" || true
fi

if [[ -x "$LOCAL_GRADLE" ]]; then
  exec "$LOCAL_GRADLE" "$@"
fi

if command -v gradle >/dev/null 2>&1; then
  exec gradle "$@"
fi

if command -v docker >/dev/null 2>&1; then
  exec docker run --rm \
    -u "$(id -u):$(id -g)" \
    -v "$PWD":/home/gradle/project \
    -w /home/gradle/project \
    gradle:8.14.0-jdk21 \
    gradle "$@"
fi

echo "repo-local Gradle(.specyn/tools), 시스템 gradle, 또는 docker가 필요합니다. 먼저 루트에서 make bootstrap(또는 python scripts/specyn_tasks.py bootstrap)을 실행해 로컬 Gradle 준비를 시도하세요." >&2
exit 1
