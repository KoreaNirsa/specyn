# Specyn auth mode
# - chatgpt: Docker agent 안의 Codex CLI가 ChatGPT 계정 로그인 캐시를 사용
# - openapi: Docker agent와 AI Server가 OPENAI_API_KEY 기반으로 동작
SPECYN_AUTH_MODE=chatgpt

# OpenAI / Codex
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.4
CODEX_MODEL=gpt-5.4
CODEX_EXEC_MODE=cli
CODEX_COMMAND_TEMPLATE=codex exec --json --model {model} --sandbox danger-full-access -C {workspace} --skip-git-repo-check
CODEX_TIMEOUT_SECONDS=900
CODEX_HOME=.specyn/codex

# Local native run endpoints
# Docker Compose 실행 시 backend -> ai-server 연결은 service name으로 자동 override 된다.
AI_SERVER_URL=http://localhost:8000
BACKEND_URL=http://localhost:8080
VITE_BACKEND_URL=http://localhost:8080
VITE_AI_SERVER_URL=http://localhost:8000

# Workspace / RAG
RAG_DOCS_DIR=docs
AXBUILDER_WORKSPACE=.workspace

# Security / CORS
AXB_SECURITY_ENABLED=false
AXB_CORS_ALLOWED_ORIGINS=http://localhost:4173,http://127.0.0.1:4173,http://localhost:5173,http://127.0.0.1:5173
